    {
     "type": "figure",
     "src": "img/chart.png",
     "alt": "Sales chart",
     "caption": [
      {
       "type": "text",
       "value": "Sales by "
      },
      {
       "type": "emphasis",
       "children": [
        {
         "type": "text",
         "value": "quarter"
        }
       ]
      }
     ]
    },
    {
     "type": "figure",
     "src": "raw.png",
     "alt": "",
