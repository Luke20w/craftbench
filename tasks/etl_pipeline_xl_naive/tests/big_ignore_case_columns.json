  "id": "in-branch",
  "flags": [
   "--execute"
  ],
  "request": {
   "options": {
    "ignore_case_columns": true
   },
   "pipeline": {
    "steps": [
     {
      "op": "branch",
      "branches": [
       {
        "when": "Kind == \"a\"",
        "steps": [
         {
          "op": "map",
          "as": "Y",
          "expr": "X + 1"
         }
        ]
       },
       {
        "when": "otherwise",
        "steps": [
         {
          "op": "branch",
          "branches": [
           {
            "when": "X > 0",
            "steps": [
             {
              "op": "math",
              "column": "X",
              "fn": "neg"
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   "dataset": [
    {
     "kind": "a",
     "x": 1
    },
    {
     "KIND": "b",
     "x": 2
    }
   ]
  },
  "code": 0,
  "expected": {
   "status": "ok",
   "data": [
    {
     "kind": "a",
     "x": 1,
     "Y": 2
    },
    {
     "KIND": "b",
     "x": -2
    }
   ],
   "metrics": {
    "rows_in": 2,
    "rows_out": 2
   }
  }
