     "price": 2,
     "qty": 3
    }
   ]
  },
  "code": 0,
  "expected": {
   "status": "ok",
   "data": [
    {
     "id": 1,
     "Total": 6
    }
   ],
   "metrics": {
    "rows_in": 1,
    "rows_out": 1
   }
  }
 },
