     "b": "2024-01-01",
     "n": -60
    },
    {
     "a": "2023-12-31",
     "b": "2024-12-31",
     "n": 366
    },
    {
     "a": null,
     "b": "2024-01-01",
     "n": null
    },
    {
     "a": "2024-01-01",
     "b": null,
     "n": null
    },
    {
