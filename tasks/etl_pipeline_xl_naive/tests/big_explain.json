     "writes": [],
     "removes": []
    },
    {
     "path": "pipeline.steps[1]",
     "op": "map",
     "reads": [
      "price",
      "qty"
     ],
     "writes": [
      "total"
     ],
     "removes": []
    },
    {
     "path": "pipeline.steps[2]",
     "op": "rename",
     "reads": [
      "total"
     ],
     "writes": [
      "amount"
     ],
     "removes": [
      "total"
     ]
    },
    {
     "path": "pipeline.steps[3]",
